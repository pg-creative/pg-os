# ─── Google Calendar + Gmail ─────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3030/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3030/api/auth/google/callback

# ─── Spotify ─────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard → Create app
# Redirect URI: http://localhost:3030/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3030/api/auth/spotify/callback

# ─── Whoop ───────────────────────────────────────────────────────────
# https://developer.whoop.com/ → Sign up as developer → Create app
# Redirect URI: http://localhost:3030/api/auth/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3030/api/auth/whoop/callback

# ─── Session cookie encryption ───────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_PASSWORD=

# ─── Supabase Realtime — PUBLISHABLE keys only (safe in browser bundles) ────
# PG OS publishable key: Supabase dashboard → qpgpljxxytehbntggtcq → Settings → API → Publishable key
PGOS_SUPABASE_PUBLISHABLE_KEY=
# HC publishable key: Supabase dashboard → ystqevehdgoonhpjmgis → Settings → API → Publishable key
HC_SUPABASE_PUBLISHABLE_KEY=
