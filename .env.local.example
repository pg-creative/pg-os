# ─── Google Calendar + Gmail ─────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3030/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3030/api/auth/google/callback

# ─── Spotify ─────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard → Create app
# Redirect URI: http://localhost:3030/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3030/api/auth/spotify/callback

# ─── Whoop ───────────────────────────────────────────────────────────
# https://developer.whoop.com/ → Sign up as developer → Create app
# Redirect URI: http://localhost:3030/api/auth/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3030/api/auth/whoop/callback

# ─── Session cookie encryption ───────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_PASSWORD=

# ─── Supabase Realtime — PUBLISHABLE keys only (safe in browser bundles) ────
# PG OS publishable key: Supabase dashboard → qpgpljxxytehbntggtcq → Settings → API → Publishable key
PGOS_SUPABASE_PUBLISHABLE_KEY=
# HC publishable key: Supabase dashboard → ystqevehdgoonhpjmgis → Settings → API → Publishable key
HC_SUPABASE_PUBLISHABLE_KEY=

# ─── The one secret ──────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
# The `tr` matters. It is pasted into `?key=` verbatim, and a raw base64 `+`
# decodes to a SPACE in a query string, so a secret containing one authenticates
# from a cookie and silently 404s from the URL handshake. base64url has the same
# 32 bytes of entropy and survives a URL as typed.
#
# Visit ?key=<this> once per device; the pgos-auth cookie lasts 90 days.
#
# It gates the whole OS AND the cosmos (plan 7i, D16: "two secrets double what
# can be lost"; COSMOS_KEY is deleted). The two behave differently on purpose:
#   the OS      unset means open, which is what dev on a laptop wants
#   /cosmos     unset or wrong means 404, always, in dev as much as in prod.
#               The practice world and the depths are private forever.
PGOS_SHARED_SECRET=

# ─── Paths ───────────────────────────────────────────────────────────
# The personal workspace. Defaults to ~/cortex when unset.
PG_ROOT=/Users/pg/cortex
# The vault. Read at request time, never copied into the repo or into public/.
COSMOS_ROOT=/Users/pg/cortex/cosmos
