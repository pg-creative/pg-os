{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/autonomy",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/cross-tab",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/post-mortem-sweep",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/push-triggers",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "src/app/api/copilot/chat/route.ts": {
      "maxDuration": 60
    }
  }
}
