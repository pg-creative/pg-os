direction: down

title: {
  shape: text
  label: "How requests reach you"
  near: top-center
  style: {
    font-size: 36
    bold: true
    font-color: "#333333"
  }
}

subtitle: {
  shape: text
  label: "PG OS Dashboard ↔ Claude Code · queue flow"
  near: top-center
  style: {
    font-size: 16
    italic: true
    font-color: "#888888"
  }
}

# 2x2 grid layout — 1 (TL) → 2 (TR) → 3 (BR) → 4 (BL) — clockwise
flow: {
  grid-columns: 2
  grid-gap: 60
  style: { stroke-width: 0; fill: "transparent" }

  # ── 1 — TOP-LEFT — Writers ──────────────────────────────────────
  sources: {
    label: "1. WHO ASKS FOR YOUR ATTENTION\nthe writers\n\n• AI sessions you're running   (Claude Code)\n• Background automations   (cron · launchd)\n• Texts from your phone   (Telegram webhook)\n• Things you capture yourself   (Capture FAB)"
    style: {
      fill: "#FFF8F0"
      stroke: "#D4A04A"
      stroke-width: 3
      border-radius: 12
      font-size: 18
      bold: true
      font-color: "#333333"
    }
  }

  # ── 2 — TOP-RIGHT — Queue ───────────────────────────────────────
  inbox: {
    shape: cylinder
    label: "2. THE INBOX\nthe queue\n\nEach request = one .md file\nat ~/.pg-os/queue/\n\nMirrored to Supabase\n(queue_items table)"
    style: {
      fill: "#F0F7FF"
      stroke: "#5B9BD5"
      stroke-width: 3
      font-size: 18
      bold: true
      font-color: "#333333"
    }
  }

  # ── 4 — BOTTOM-LEFT — Dispatch ─────────────────────────────────
  jobs: {
    shape: package
    label: "4. LAUNCH A JOB\nagent dispatch\n\nClick 'Run Now' on the dashboard\n→ POST /api/claude/run-agent\n→ spawns a headless Claude Code\n   that drops new requests in the inbox"
    style: {
      fill: "#FFF5F0"
      stroke: "#E8805A"
      stroke-width: 3
      font-size: 18
      bold: true
      font-color: "#333333"
    }
  }

  # ── 3 — BOTTOM-RIGHT — Dashboard ───────────────────────────────
  dashboard: {
    label: "3. YOUR DASHBOARD\nPG OS Flow tab\n\n• Reads the inbox via /api/queue\n• Approve / Dismiss with one click\n• Triage Mode (keyboard 1-9 / A D X S)\n• Every decision logged to decisions_log"
    style: {
      fill: "#F0FFF4"
      stroke: "#2D8B4E"
      stroke-width: 3
      border-radius: 12
      font-size: 18
      bold: true
      font-color: "#333333"
    }
  }
}

# Clockwise flow — TL → TR → BR → BL
flow.sources -> flow.inbox: "writes a request" {
  style: { font-size: 17; bold: true; stroke: "#666666"; stroke-width: 2 }
}

flow.inbox -> flow.dashboard: "you review" {
  style: { font-size: 17; bold: true; stroke: "#666666"; stroke-width: 2 }
}

flow.dashboard -> flow.jobs: "click 'Run Now'" {
  style: { font-size: 17; bold: true; stroke: "#666666"; stroke-width: 2 }
}

# Footnote — the one important caveat (no inbound to live sessions)
note: {
  shape: text
  label: "One catch: an already-running Claude Code session can't be interrupted.\nIt only sees your decisions on its NEXT read of the inbox."
  near: bottom-center
  style: {
    font-size: 15
    italic: true
    font-color: "#C44545"
  }
}
