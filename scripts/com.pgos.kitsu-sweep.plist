<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kitsu proactive sweep (Phase 4). Every 30 minutes, asks the LOCAL PG OS dev
  server to review the fleet + queue and surface anything that needs PG (nudges
  to the Flow queue, a push notification for urgent items). The sweep is free
  (deterministic, no LLM) and idempotent. It silently no-ops if the dev server
  is not running. Targets :3030 (PG's normal `pnpm dev` port).

  Install:   bash scripts/install-kitsu-sweep.sh
  Uninstall: launchctl unload ~/Library/LaunchAgents/com.pgos.kitsu-sweep.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pgos.kitsu-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/curl</string>
    <string>-fsS</string>
    <string>-m</string>
    <string>30</string>
    <string>-X</string>
    <string>POST</string>
    <string>http://127.0.0.1:3030/api/kitsu/sweep</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/pg/.pg-os/kitsu/sweep.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pg/.pg-os/kitsu/sweep.log</string>
</dict>
</plist>
